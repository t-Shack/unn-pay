# UNN Pay backend configuration.
# Copy to .env for local development. NEVER commit a real .env.
# Every value below is a placeholder.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (PostgreSQL 15+) -------------------------------------------------
DATABASE_URL=postgres://unnpay:unnpay@localhost:5432/unnpay
# true when connecting over the public internet (e.g. Render external URL)
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Auth ----------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_32_bytes_of_random_hex_00000000
JWT_REFRESH_SECRET=replace_me_with_32_bytes_of_random_hex_11111111
RECEIPT_SIGNING_SECRET=replace_me_with_32_bytes_of_random_hex_22222222
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Bank collection adapter ---------------------------------------------------
# sandbox | gtbank
BANK_ADAPTER=sandbox
BANK_WEBHOOK_SECRET=replace_me_with_a_shared_webhook_secret
BANK_WEBHOOK_TOLERANCE_SECONDS=300

# GTBank only. Read exclusively by GTBankAdapter (see spec 5.1).
GTBANK_API_BASE_URL=
GTBANK_API_KEY=
GTBANK_MERCHANT_ID=
GTBANK_TIMEOUT_MS=15000

# --- Notifications -------------------------------------------------------------
# Single line JSON of the Firebase service account. Leave blank to disable push.
FIREBASE_SERVICE_ACCOUNT_JSON=
RESEND_API_KEY=
EMAIL_FROM=UNN Pay <no-reply@pay.unn.edu.ng>
BURSARY_ALERT_EMAIL=bursary@unn.edu.ng

# --- Business rules ------------------------------------------------------------
PAYMENT_REFERENCE_TTL_HOURS=24
UNAPPLIED_RESOLUTION_DAYS=90

# --- Public surface ------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:4000
# Comma separated CORS allowlist for the admin SPA
ADMIN_ORIGINS=http://localhost:5173
# Comma separated custom schemes used by the mobile app
APP_SCHEMES=unnpay

# --- Observability -------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Worker schedules ----------------------------------------------------------
RECONCILE_CRON=*/10 * * * *
OUTBOX_CRON=*/1 * * * *
DAILY_MAINTENANCE_CRON=15 1 * * *

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=60000
