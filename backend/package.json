{
  "name": "unn-pay-backend",
  "version": "1.0.0",
  "private": true,
  "description": "UNN Pay — fee collection API and background worker for the University of Nigeria, Nsukka",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/worker/index.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker/index.js",
    "db:dev": "node src/scripts/devDatabase.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "seed:superadmin": "node src/scripts/createSuperAdmin.js",
    "seed:demo": "node src/scripts/seedDemoData.js",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@sentry/node": "^8.47.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "decimal.js": "^10.4.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "multer": "^2.0.1",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "resend": "^4.0.1",
    "sequelize": "^6.37.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  }
}
